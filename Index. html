    <!-- JavaScript for Modals -->
    
        <script>
    // --- Modal Control ---
    function openModal(id) {
        document.getElementById(id).classList.remove('hidden');
    }
    
    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    // --- AI Teacher Engine ---
    async function askAI() {
        const input = document.getElementById('ai-input').value;
        const display = document.getElementById('ai-response-display');
        
        if (!input) return alert("Kuch toh poocho bhai!");

        display.innerHTML = "<p class='text-blue-400'>Coach dimaag chala raha hai... 🤔</p>";

        try {
            // NOTE: Yahan 'YOUR_API_KEY' ki jagah apni Gemini API Key daalo
            const API_KEY = "AQ.Ab8RN6Lrdtq5-espGaFztiEpZh3aqYbdM-JjtA7d9Db5LG2DkA"; 
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`;

            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contents: [{ parts: [{ text: "Explain this concept for a JEE aspirant in simple Hinglish: " + input }] }]
                })
            });

            const data = await response.json();
            const answer = data.candidates[0].content.parts[0].text;
            
            // Format response
            display.innerHTML = `<p class='text-slate-300'>${answer.replace(/\n/g, '<br>')}</p>`;
        } catch (error) {
            display.innerHTML = "<p class='text-red-400'>Error: API connection fail hua. Check your key!</p>";
        }
    }
</script>
